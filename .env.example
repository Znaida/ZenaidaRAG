# ===== ZenaidaRAG — configuracion de ejemplo =====
# Copia este archivo a .env y completa. NUNCA commitees el .env real.

# --- LLM (ADR-005). Proveedor por defecto: gemini ---
# Opciones: gemini | openai | fake (fake = sin red, para pruebas)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=...tu-key-de-gemini-aqui...

# Alternativa OpenAI (opcional):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Embeddings (ADR-004). Por defecto: locales, $0 ---
EMBEDDINGS_PROVIDER=local
# Multilingue (recomendado para corpus en espanol):
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Alternativa mas liviana (ingles, menos preciso en espanol):
# EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Umbral de similitud minimo (anti-alucinacion, ADR-006):
MIN_SCORE=0.35

# --- Vector store (ADR-003). Por defecto: ChromaDB local ---
VECTOR_STORE=chroma
CHROMA_PATH=data/chroma
COLLECTION_NAME=zenaidarag

# --- Ingesta / recuperacion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=6
FETCH_K=20

# --- Calidad de recuperacion (Fase 4, ADR-011). Opcionales ---
# Busqueda hibrida (semantica + BM25): sin descargas, mejor en docs grandes.
USE_HYBRID=true
# Reranking con cross-encoder (~450 MB): precision fina en datos especificos.
USE_RERANK=false
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Modelos locales (Fase 7). Se guardan JUNTO al proyecto, no en C: ---
# Por defecto <proyecto>/models. Descomenta para elegir otra ruta (ej. otro disco):
# ZENAIDA_MODELS_DIR=D:\ruta\a\modelos

# --- API (Fase 3) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Canales (Fase 5, opcional) ---
# Crea un bot con @BotFather en Telegram y pega el token aqui:
TELEGRAM_BOT_TOKEN=
